NODE_ENV=production
PORT=8080
DATABASE_URL=postgres://competition:change-this@db:5432/competition
POSTGRES_PASSWORD=replace-with-a-unique-random-secret
COOKIE_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=true
PUBLIC_BASE_URL=https://comp.psc-robotics.uk
OIDC_ISSUER=https://auth.psc-robotics.uk/application/o/competition-management/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://comp.psc-robotics.uk/auth/callback
# "true" only accepts emails the identity provider marks as verified (Authentik reports false by default).
OIDC_REQUIRE_VERIFIED_EMAIL=false
# Optional: only these (comma-separated) emails may sign in. Empty = any account the identity provider accepts.
ADMIN_EMAILS=
# Which proxies to trust for client addresses (used for sign-in rate limits).
TRUST_PROXY=loopback,linklocal,uniquelocal
# Passkeys are tied to the PUBLIC_BASE_URL host; override only if they must work on a parent domain.
PASSKEY_RP_ID=
PASSKEY_RP_NAME=Competition Control
LOG_LEVEL=info
# Live audio between browsers. Empty works when the admin computer and screens share a network;
# add STUN/TURN servers as JSON when they do not, e.g. [{"urls":"stun:stun.example.org:3478"}].
WEBRTC_ICE_SERVERS=
